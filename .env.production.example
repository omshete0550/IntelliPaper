POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
OPENALEX_EMAIL=your-email@example.com
OPENALEX_API_KEY=
# Generate a unique random value for production. API and ML service must use the same value.
SIMILARITY_SERVICE_TOKEN=replace-with-a-long-random-shared-secret
SIMILARITY_REQUIRE_TOKEN=true
# Keep true locally. Use false for a 512 MB free ML web service on Render.
SEMANTIC_ENABLED=true
